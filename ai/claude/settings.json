{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/git-guard.py",
            "timeout": 10,
            "statusMessage": "checking git rules"
          }
        ]
      },
      {
        "matcher": "Agent|Task|Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/audit-gate.py",
            "timeout": 15,
            "statusMessage": "checking audit rules"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/correction-check.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "feedbackDrafts": "notify",
  "theme": "auto",
  "awaySummaryEnabled": false
}
