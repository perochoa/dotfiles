# Shared git settings for every machine. Linked to ~/.config/git/config by bootstrap.sh.
# Identity and machine-specific overrides live in ~/.gitconfig (git/gitconfig.local), which wins on conflicts.

[fetch]
  prune = true

[alias]
  co = checkout
  cob = checkout -b
  fp = fetch --prune
  pl = pull
  plr = pull --rebase
  pf = push --force-with-lease
  st = status
  rs = restore --staged
  cm = commit -m
  ca = commit -am
  rb = rebase
  br = branch
  cma = "!f() { git add -A && git commit -m \"$*\"; }; f"
